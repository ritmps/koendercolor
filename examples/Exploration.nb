Cell[CellGroupData[{

Cell["5. Distance along the Achromatic Diagonal (Paper Figure 13)", "Section",ExpressionUUID->"dc139869-99b4-44d0-bd60-d1230a69f94e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"grayPts", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", "g", ",", "g"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"g", ",", "0.2", ",", "0.8", ",", "0.05"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"vols", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{"KoenderinkMetricMatrix", "[", "#", "]"}], "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], "&"}], ",", "grayPts"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{4.001963961700252*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"73ea84ac-f38d-45de-ad79-dda73babb008"],

