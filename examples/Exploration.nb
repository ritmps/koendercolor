Cell["4. Evaluating Metric Tensor and Color Distance", "Section",ExpressionUUID->"365b8408-9265-40c3-9a2b-173ecf6d7818"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"c1", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.5", ",", "0.5", ",", "0.5"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c2", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.55", ",", "0.5", ",", "0.5"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Midpoint Riemannian chord distance: \>\"", ",", 
    RowBox[{"KoenderinkColorDistance", "[", 
     RowBox[{"c1", ",", "c2"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Line-integral arc length: \>\"", ",", 
    RowBox[{"KoenderinkColorDistance", "[", 
     RowBox[{"c1", ",", "c2", ",", 
      RowBox[{"\"\<Method\>\"", "->", "\"\<LineIntegral\>\""}]}], "]"}]}], 
   "]"}], ";"}]}], "Input",
