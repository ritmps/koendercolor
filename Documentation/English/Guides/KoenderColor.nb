   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "7de9ebd5-06cb-4748-96f0-ab29b8d20e77"],
 " \[LongDash] ",
 "Computes the partition-of-unity Gaussian RBF weights for the 35 empirical \
reference points."
}], "GuideText",ExpressionUUID->"0b0c4ff0-7cf1-4070-952b-186793307a48"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FrobeniusMismatch"]], 
    "paclet:KoenderColor/ref/FrobeniusMismatch"},
   "RefLink",
