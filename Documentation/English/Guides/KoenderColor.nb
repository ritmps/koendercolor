Cell[CellGroupData[{

Cell["KoenderColor Guide", "GuideTitle",ExpressionUUID->"87e02df0-f2ae-402a-9ce2-d3d5b9bd1e84"],

Cell["\<\
KoenderColor provides tools for analyzing and computing color differences \
using the 3D empirical metric field developed by Jan Koenderink, Andrea van \
Doorn, Doris Braun, and Karl Gegenfurtner (2026).\
\>", "GuideAbstract",ExpressionUUID->"9fc2bb31-b5bc-423c-bc7a-cd098b025f54"],

Cell[CellGroupData[{

Cell["Reference", "GuideReferenceSection",ExpressionUUID->"ccb46363-37b1-4665-9ff6-4f3498c655d2"],

Cell[CellGroupData[{

Cell["Metric & Color Distance", "GuideFunctionsSubsection",ExpressionUUID->"693b112b-0dac-404c-900f-5dcc39c4d21d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkColorDistance"]], 
    "paclet:KoenderColor/ref/KoenderinkColorDistance"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "8327905d-a412-4b59-ad2c-a08a21715333"],
 " \[LongDash] ",
 "Computes the perceptual color distance between colors c1 and c2 in units of \
Notable Qualitative Differences (NQD)."
}], "GuideText",ExpressionUUID->"e3077551-04a2-4b6e-a7d5-3561b0c1ef0a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkMetricMatrix"]], 
    "paclet:KoenderColor/ref/KoenderinkMetricMatrix"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "8b479c25-0370-407c-9669-4ae51d83805b"],
 " \[LongDash] ",
 "Computes the interpolated 3x3 symmetric positive-definite Sigma matrix at \
color."
}], "GuideText",ExpressionUUID->"5bb78157-8f35-4514-8e9a-290126dfe5fc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkMetricTensor"]], 
    "paclet:KoenderColor/ref/KoenderinkMetricTensor"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "94521160-9b98-48cc-9ff1-8acab0f68b1f"],
 " \[LongDash] ",
 "Returns the Riemannian metric tensor g(color) = \
Inverse[KoenderinkMetricMatrix[color]]."
}], "GuideText",ExpressionUUID->"df4ee471-b0ec-4779-8346-cee3cc0345db"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkEllipsoid"]], 
    "paclet:KoenderColor/ref/KoenderinkEllipsoid"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "173de722-48a3-4674-8eca-baf3817e3d4f"],
 " \[LongDash] ",
 "Returns a Graphics3D Ellipsoid primitive representing the Notable \
Qualitative Difference (NQD) region at color."
}], "GuideText",ExpressionUUID->"e1f83f98-def1-467e-800a-7c4d9f1eef5e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Empirical Lattice Data & Interpolation", "GuideFunctionsSubsection",ExpressionUUID->"4646e785-f3fe-4d4c-8803-a88f7634214b"],

Cell[TextData[{
 Cell[BoxData[
