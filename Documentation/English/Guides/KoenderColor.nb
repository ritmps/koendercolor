Cell[CellGroupData[{

Cell["KoenderColor Guide", "GuideTitle",ExpressionUUID->"f552eb68-6acc-4bbb-9080-60ae09975d9a"],

Cell["\<\
KoenderColor provides tools for analyzing and computing color differences \
using the 3D empirical metric field developed by Jan Koenderink, Andrea van \
Doorn, Doris Braun, and Karl Gegenfurtner (2026).\
\>", "GuideAbstract",ExpressionUUID->"b4f728c4-8e8b-47ce-8f5d-4c1b897eaa1c"],

Cell[CellGroupData[{

Cell["Reference", "GuideReferenceSection",ExpressionUUID->"83d5aa9f-661c-47c8-8448-2d25498fd36d"],

Cell[CellGroupData[{

Cell["Metric & Color Distance", "GuideFunctionsSubsection",ExpressionUUID->"4cb0cb68-632c-4093-91f8-42698377c6d5"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkColorDistance"]], 
    "paclet:KoenderColor/ref/KoenderinkColorDistance"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "615fcdc2-eb15-4da4-92f0-09ba618e3210"],
 " \[LongDash] ",
 "Computes the perceptual color distance between colors c1 and c2 in units of \
Notable Qualitative Differences (NQD)."
}], "GuideText",ExpressionUUID->"07bd7fe0-e795-49e5-9483-5eb6850918da"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkMetricMatrix"]], 
    "paclet:KoenderColor/ref/KoenderinkMetricMatrix"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "5969bbb9-b1b3-4a47-a397-76cd7a4a1b09"],
 " \[LongDash] ",
 "Computes the interpolated 3x3 symmetric positive-definite Sigma matrix at \
color."
}], "GuideText",ExpressionUUID->"ada3447f-0089-40b2-b03e-a3d61fb47e34"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkMetricTensor"]], 
    "paclet:KoenderColor/ref/KoenderinkMetricTensor"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "f227bdf5-fda9-4a81-a4c4-6877229471b6"],
 " \[LongDash] ",
 "Returns the Riemannian metric tensor g(color) = \
Inverse[KoenderinkMetricMatrix[color]]."
}], "GuideText",ExpressionUUID->"2d143c84-aafd-4704-ae42-6f54a2edf061"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkEllipsoid"]], 
    "paclet:KoenderColor/ref/KoenderinkEllipsoid"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "0fa66358-25f1-436e-832b-dd88ba4326d0"],
 " \[LongDash] ",
 "Returns a Graphics3D Ellipsoid primitive representing the Notable \
Qualitative Difference (NQD) region at color."
}], "GuideText",ExpressionUUID->"9fcd02c7-2557-4944-ba97-fe963f591949"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Empirical Lattice Data & Interpolation", "GuideFunctionsSubsection",ExpressionUUID->"2a0be6d8-4797-4a7c-b963-573055da3390"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkData"]], "paclet:KoenderColor/ref/KoenderinkData"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]],ExpressionUUID->
  "0b15426a-e1f9-419d-9938-35e39415ffee"],
 " \[LongDash] ",
 "Returns the empirical dataset of 35 reference colors and fitted Sigma \
matrices from Koenderink et al."
}], "GuideText",ExpressionUUID->"5288e071-c68d-40bc-80e4-7e69553ea072"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KoenderinkWeights"]], 
