reference points."
}], "GuideText",ExpressionUUID->"0571622d-34c3-4634-8714-31e4ff0de29b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FrobeniusMismatch"]], 
